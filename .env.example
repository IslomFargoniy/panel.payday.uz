APP_NAME=Payday
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://panel.payday.uz

APP_LOCALE=uz
APP_FALLBACK_LOCALE=uz
APP_FAKER_LOCALE=uz_UZ

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=payday
DB_USERNAME=root
DB_PASSWORD=
DB_STRICT=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=https://panel.payday.uz/auth/google/callback

TELEGRAM_BOT_TOKEN=
TELEGRAM_LOG_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

HIKVISION_GATEWAY_URL=http://127.0.0.1:7661
HIKVISION_GATEWAY_TOKEN=
HIKVISION_GATEWAY_TOKEN_REQUIRED=false
HIKVISION_USE_DEVICE_TIME=false
HIKVISION_LATE_DELIVERY_SECONDS=600
HIKVISION_LATE_DELIVERY_MAX_AGE_DAYS=45
HIKVISION_CATCHUP_GAP_MINUTES=30
HIKVISION_RESTART_COMMAND="sudo systemctl restart hikvision-isup"
HIKVISION_DAS_ADDRESS=193.180.213.188
HIKVISION_TIMEOUT=10

TELESCOPE_ENABLED=false
